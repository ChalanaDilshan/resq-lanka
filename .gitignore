# ============================================================
# Root-level .gitignore for resq-lanka
# ============================================================

# Architecture / planning documents — local only, never push
../ARCHITECTURE/
ARCHITECTURE/

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/

# Dependency directories
node_modules/

# Environment files — NEVER commit real secrets or environment configs
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Skills & agent artifacts
skills/
