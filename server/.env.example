# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resq-lanka
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
ADMIN_EMAIL=admin@resqlanka.lk
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Email Service (Gmail SMTP for resqlanka@gmail.com)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=resqlanka@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# Client URL (for backend CORS allowance in production)
CLIENT_URL=https://resq-lanka.vercel.app
